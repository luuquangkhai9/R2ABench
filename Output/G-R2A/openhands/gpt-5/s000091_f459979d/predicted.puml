@startuml
title s000091_f459979d – System Architecture

skinparam componentStyle rectangle
hide circle

' External clients/systems
rectangle "Authenticated API Client\n(HTTP + Authorization)" as API <<external>>
rectangle "Backend Integration Service" as BackendSvc <<external>>
rectangle "LwM2M Service Component" as Lwm2mSvc <<external>>
rectangle "Ethereum-Compatible Node\n(Web3j HTTP)" as EthNode <<external>>

package "Management API (Spring)" {
  component "UserController\n- GET /users\n- POST /add" as UserController
  component "JwtUtility\nisValidToken(auth,1)" as JwtUtility
  component "UserService" as UserService
  note right of UserController
  Access-controlled operations:
  0 -> allow
  1 -> 401 Unauthorized
  2 -> 403 Forbidden
  other -> 400 Bad Request
  end note
}

package "Blockchain Integration" {
  component "BlockchainService\n- getAllClientSecurity()\n- addClient()\n- getClientByEndpoint()" as BlockchainService
  component "Fixed32BytesCodec\nASCII encode/decode (32 bytes)" as Codec
  component "Web3j Client" as Web3j
  component "ClientBootstrapContract" as Contract
  note right of BlockchainService
  FR-003: On contract access failure,
  record exception and return empty collection.
  FR-004: Before addClient, encode strings to fixed 32-byte ASCII.
  FR-005: For get by endpoint, encode endpoint, decode fields,
  assemble bootstrap configuration.
  end note
}

package "LwM2M Handling" {
  component "LwM2MNodeParser\n(JSON -> typed nodes)" as NodeParser
  component "Leshan/LwM2M Model Types" as Leshan
  note right of NodeParser
  - Deserialize valid JSON to typed nodes
  - Reject invalid payloads (e.g., instances without required id)
  Type mapping:
  boolean->BOOLEAN, string->STRING,
  number: long-fit->INTEGER else FLOAT,
  other primitives->STRING
  end note
}

' API flows
API --> UserController : HTTP requests
UserController --> JwtUtility : validate token
UserController --> UserService : retrieve/create users

' Blockchain flows (invoked by backend integration usages)
BackendSvc --> BlockchainService
BlockchainService --> Codec : encode/decode 32B ASCII
BlockchainService --> Web3j
Web3j --> EthNode : HTTP JSON-RPC
BlockchainService --> Contract : contract calls

' LwM2M flows
Lwm2mSvc --> NodeParser : JSON payloads
NodeParser --> Leshan : type mapping

@enduml
