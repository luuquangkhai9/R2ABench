@startuml
!define RECTANGLE rectangle
!define COMPONENT component
!define INTERFACE interface
!define DATABASE database
!define NOTE note
!define FRAME frame
!define PACKAGE package
!define NODE node

' Main system boundary
rectangle "veinmind-tools Suite" as suite {
  
  ' Core components
  COMPONENT "veinmind-sdk /\nlibveinmind" as sdk [
    SDK/Library family providing
    core scanning capabilities
    and plugin interfaces
  ]
  
  COMPONENT "CLI Commands" as cli [
    Command-line interface layer
    exposing scan commands:
    - scan-image
    - scan-container
    - scan-iac
  ]
  
  COMPONENT "Runner Execution\nFramework" as runner [
    Parallel-container execution
    support through veinmind-runner
    and startup scripts
  ]
  
  COMPONENT "Authorization\nRouting Engine" as auth [
    Docker authorization request
    classifier mapping method/URI
    to plugin actions
  ]
  
  COMPONENT "Reporting\nSubsystem" as reporting [
    Structured data representation
    for scan results and alerts:
    - Malicious file reports
    - IaC alert details
  ]
  
  ' Plugin components
  COMPONENT "Plugin Examples" as plugins [
    Container packaging examples
    demonstrating SDK usage
    for custom scanning logic
  ]
  
  ' Data structures
  DATABASE "Report Data\nStructures" as data [
    MaliciousFileInfo
    ReportData
    ReportImage
    ReportLayer
    IaC Alert Details
  ]
}

' External systems
NODE "Docker Runtime" as docker [
  Container runtime environment
  required for quick-start workflows
]

NODE "IaC Input Sources" as iac_sources [
  Infrastructure as Code files
  in supported formats
]

NODE "Plugin Developer\nEnvironment" as dev_env [
  Development environment for
  creating custom scanning plugins
]

' Relationships
cli --> sdk : uses
runner --> sdk : uses
auth --> sdk : uses
reporting --> sdk : uses
plugins --> sdk : built with

cli --> runner : executes
runner --> docker : requires

auth <-- docker : receives\nauthorization\nrequests
auth --> data : produces\nplugin action\nresults

reporting --> data : manages
cli --> reporting : generates\nreports
runner --> reporting : generates\nreports

plugins --> docker : packaged\nas containers
dev_env --> plugins : develops

iac_sources --> cli : provides\ninput for\nscan-iac
data --> reporting : stores

' Data flows
NOTE right of data
  Data Exchange Formats:
  - DAT-IF-001: Malicious-file reports
  - DAT-IF-002: IaC alert details
  - DAT-IF-003: Docker plugin actions
end note

NOTE bottom of auth
  Authorization Routing:
  - Matches request method/URI 
    to configured patterns
  - Returns NoneDockerPlugin
    for unmatched requests
end note

NOTE top of runner
  Quick-start Workflow:
  ./run.sh scan-host image
  Requires prepared runner image
  and startup script
end note

@enduml