@startuml Home_Recipes_Architecture

skinparam backgroundColor #FAFAFA
skinparam package {
  BorderColor #555555
  FontStyle bold
  FontSize 13
}
skinparam component {
  BackgroundColor #DDEEFF
  BorderColor #336699
  FontSize 12
}
skinparam node {
  BackgroundColor #EEF5EE
  BorderColor #336633
  FontSize 12
}
skinparam database {
  BackgroundColor #FFF5DD
  BorderColor #996600
}
skinparam cloud {
  BackgroundColor #EDE8F5
  BorderColor #6633AA
}
skinparam arrow {
  Color #444444
  FontSize 11
}

' ─────────────────────────────────────────────────────────────
' CONTRACT LAYER (build-time artifact foundation)
' ─────────────────────────────────────────────────────────────
package "Contract Layer (Build-Time)" as ContractLayer #FFF8DC {

  component [ProtoContract\n(.proto definitions\n+ gRPC-Gateway annotations)] as ProtoContract
  component [VendorProtoLibs\n(googleapis & third-party\ngateway definition deps)] as VendorProtoLibs

  component [ProtocCore\n(protoc compiler)] as ProtocCore
  component [PluginProtocGenGo\n(protoc-gen-go\n+ protoc-gen-go-grpc)] as PluginProtocGenGo
  component [PluginProtocGenDart\n(protoc-gen-dart)] as PluginProtocGenDart
  component [PluginProtocGenGateway\n(protoc-gen-grpc-gateway)] as PluginProtocGenGateway

  ProtocCore --> PluginProtocGenGo      : invokes
  ProtocCore --> PluginProtocGenDart    : invokes
  ProtocCore --> PluginProtocGenGateway : invokes

  PluginProtocGenGo      --> ProtoContract     : reads
  PluginProtocGenDart    --> ProtoContract     : reads
  PluginProtocGenGateway --> ProtoContract     : reads
  PluginProtocGenGateway --> VendorProtoLibs   : depends on (C-003)
}

' ─────────────────────────────────────────────────────────────
' CLIENT LAYER
' ─────────────────────────────────────────────────────────────
package "Client Layer" as ClientLayer #D6EAF8 {

  node "Flutter Application\n(Android | iOS | Web | macOS)" as FlutterNode {
    component [FlutterClient\n(Home Recipes UI)] as FlutterClient
    component [DartGeneratedStubs\n(generated by protoc-gen-dart)] as DartGeneratedStubs
  }

  FlutterClient --> DartGeneratedStubs : uses
}

' ─────────────────────────────────────────────────────────────
' GATEWAY LAYER
' ─────────────────────────────────────────────────────────────
package "Gateway Layer" as GatewayLayer #D5F5E3 {

  component [GrpcGatewayGeneratedCode\n(generated by protoc-gen-grpc-gateway)] as GrpcGatewayGeneratedCode
  component [GrpcGatewayRuntime\n(HTTP/JSON to gRPC middleware)] as GrpcGatewayRuntime

  component [HttpEndpoints\n(addRecipe, listAllRecipes,\nlistAllIngredientsAtHome,\ngetAllIngredientsForRecipe)] as HttpEndpoints <<HTTP Interface>>

  GrpcGatewayRuntime --> GrpcGatewayGeneratedCode : incorporates
  GrpcGatewayRuntime --> HttpEndpoints             : exposes
}

' ─────────────────────────────────────────────────────────────
' BACKEND LAYER
' ─────────────────────────────────────────────────────────────
package "Backend Layer" as BackendLayer #FDEDEC {

  node "Go gRPC Server" as GoGrpcNode {
    component [GoGrpcServer\n(Go gRPC host — recipe &\ningredient operations)] as GoGrpcServer
    component [GoGeneratedStubs\n(generated by protoc-gen-go)] as GoGeneratedStubs
  }

  GoGrpcServer --> GoGeneratedStubs : uses
}

' ─────────────────────────────────────────────────────────────
' DEPLOYMENT LAYER
' ─────────────────────────────────────────────────────────────
package "Deployment Layer" as DeploymentLayer #F5EEF8 {

  component [GoServerBinary\n(compiled Go server artifact)] as GoServerBinary
  component [DockerImage\n(Go gRPC Server container)] as DockerImage
  component [KubernetesManifests\n(local cluster config)] as KubernetesManifests
  component [AKSManifests\n(Azure AKS config)] as AKSManifests

  GoServerBinary   --> DockerImage          : packaged into
  KubernetesManifests --> DockerImage       : references image
  AKSManifests        --> DockerImage       : references image
}

' ─────────────────────────────────────────────────────────────
' EXTERNAL SYSTEMS
' ─────────────────────────────────────────────────────────────
cloud "Azure Kubernetes Service (AKS)" as AKS
node "Local Kubernetes Cluster" as LocalK8s
component [curl / HTTP Clients\n(API consumers and testers)] as CurlClients

' ─────────────────────────────────────────────────────────────
' CROSS-LAYER DEPENDENCIES
' ─────────────────────────────────────────────────────────────

' Contract → generated artifacts (build-time)
PluginProtocGenDart    ..> DartGeneratedStubs        : generates (build-time)
PluginProtocGenGo      ..> GoGeneratedStubs           : generates (build-time)
PluginProtocGenGateway ..> GrpcGatewayGeneratedCode   : generates (build-time)

' Generated stubs trace back to proto contract
DartGeneratedStubs       ..> ProtoContract            : generated from
GoGeneratedStubs         ..> ProtoContract            : generated from
GrpcGatewayGeneratedCode ..> ProtoContract            : generated from

' Backend binary packaging
GoGrpcServer --> GoServerBinary                       : compiled to

' Client → backend runtime communication (COM-001)
FlutterClient --> GoGrpcServer                        : gRPC transport via DartGeneratedStubs (COM-001)

' Gateway → backend runtime communication (COM-003, C-004)
GrpcGatewayRuntime --> GoGrpcServer                   : gRPC calls (COM-003)

' External HTTP clients → gateway (COM-002)
CurlClients --> HttpEndpoints                         : HTTP requests (COM-002)

' Deployment → external cluster platforms (FR-005, FR-006)
KubernetesManifests --> LocalK8s                      : deploys image to cluster
AKSManifests        --> AKS                           : deploys image to cluster

@enduml
