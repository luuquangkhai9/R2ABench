@startuml
skinparam componentStyle rectangle
left to right direction

skinparam defaultFontName Arial
skinparam shadowing false
skinparam ArrowColor #333333
skinparam ArrowThickness 1.5
skinparam package {
    BackgroundColor #FFF3CC
    BorderColor #D9A441
    BorderThickness 1
}
skinparam rectangle {
    BackgroundColor #D8F0D0
    BorderColor #669966
    BorderThickness 1
}
skinparam queue {
    BackgroundColor #FFFFFF
    BorderColor #555555
    BorderThickness 1
}
skinparam database {
    BackgroundColor #DDEBFF
    BorderColor #5577AA
    BorderThickness 1
}

package "application 1" as Application1 {
    rectangle "auditor-v1 client" as AuditorClient1
}

package "application 2" as Application2 {
    rectangle "auditor-v1 client" as AuditorClient2
}

package "application 3" as Application3 {
    rectangle "auditor-v1 client" as AuditorClient3
}

queue "Kafka" as Kafka
rectangle "auditor-v1 app\nserver" as AuditorAppServer
database "Databases / Filestores\nElastic, Hadoop, etc." as AuditStores

AuditorClient1 --> Kafka : publish audit event
AuditorClient2 --> Kafka : publish audit event
AuditorClient3 --> Kafka : publish audit event
Kafka --> AuditorAppServer : consume audit events
AuditorAppServer --> AuditStores : persist audit data
@enduml
