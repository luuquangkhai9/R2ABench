@startuml
skinparam componentStyle rectangle
left to right direction

skinparam defaultFontName Arial
skinparam shadowing false
skinparam ArrowColor #00A6C8
skinparam ArrowThickness 1.5
skinparam package {
    BackgroundColor #FFFBE0
    BorderColor #CCCCCC
    BorderThickness 1
}
skinparam rectangle {
    BackgroundColor #FFFFFF
    BorderColor #555555
    BorderThickness 1
}
skinparam cloud {
    BackgroundColor #E5F7FA
    BorderColor #555555
    BorderThickness 1
}

package "Archifiltre" as ArchifiltreApp {
    rectangle "Electron" as Electron
    rectangle "React.js" as ReactJs
    rectangle "Redux" as Redux
}

cloud "Sentry" as Sentry
cloud "Matomo" as Matomo

package "GitHub" as GitHub {
    rectangle "Continuous Integration /\nContinuous Deployment" as Cicd
    rectangle "Releases" as Releases
    rectangle "Issues /\nPull requests" as IssuesPullRequests
}

Electron --> ReactJs : desktop shell hosts UI
ReactJs --> Redux : state management
ArchifiltreApp --> Sentry : Remontees d'erreur
ArchifiltreApp --> Matomo : Donnees d'usage
GitHub --> Cicd : automation
GitHub --> Releases : release publishing
GitHub --> IssuesPullRequests : collaboration
Cicd --> ArchifiltreApp : build and deploy
ArchifiltreApp --> IssuesPullRequests : feedback and changes
@enduml
